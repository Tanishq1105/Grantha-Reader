{
  "name": "grantha-reader",
  "version": "3.5.0",
  "private": true,
  "type": "module",
  "description": "Account-based scripture book reader with React, Vite, Flask and Gemini 3.8 Flash",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vite build",
    "start": "node scripts/start.mjs",
    "test:js": "node --test tests/frontend.test.mjs && vitest run",
    "test": "python -m pytest -q && npm run test:js",
    "dev:frontend": "vite",
    "dev:api": "python -m backend.app",
    "test:react": "vitest run"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
